{# 点击"关于"时的过渡页：全屏遮罩 + 逐字打出欢迎语，短暂停留后再跳转 #}
<div id="welcome-transition" aria-hidden="true">
  <div class="welcome-plane">✈️</div>
  <p class="welcome-text"><span class="welcome-content"></span><span class="welcome-cursor"></span></p>
</div>

<style>
  #welcome-transition {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    background: linear-gradient(160deg, #fff6ee, #ffe3d1);
    opacity: 0;
    visibility: hidden;
    transition: opacity .35s ease, visibility .35s ease;
  }

  #welcome-transition.active {
    opacity: 1;
    visibility: visible;
  }

  .welcome-plane {
    font-size: 2.6rem;
  }

  /* 遮罩激活时才起飞：前 48.2%（打字阶段）盘旋一个来回，随后爬升，
     4.2s 整恰好到达最高点，与 DURATION 对齐实现"最高点处跳转" */
  #welcome-transition.active .welcome-plane {
    animation: welcome-fly 4.2s ease-in-out forwards;
  }

  @keyframes welcome-fly {
    0%    { transform: translate(-60px, 6px) rotate(8deg); }
    24.1% { transform: translate(60px, -6px) rotate(-4deg); }
    48.2% { transform: translate(-60px, 6px) rotate(8deg); }
    100%  { transform: translate(90px, -60px) rotate(-12deg); }
  }

  .welcome-text {
    margin: 0;
    padding: 0 1rem;
    font-size: clamp(1.4rem, 4.5vw, 2.6rem);
    font-weight: 700;
    color: #d94e10;
    min-height: 1.4em;
  }

  .welcome-cursor {
    display: inline-block;
    width: 3px;
    height: 1em;
    margin-left: 4px;
    vertical-align: -0.12em;
    background: #fc6423;
    animation: welcome-blink .8s step-end infinite;
  }

  @keyframes welcome-blink {
    50% { opacity: 0; }
  }

  @media (prefers-color-scheme: dark) {
    #welcome-transition {
      background: linear-gradient(160deg, #23262d, #38271c);
    }
    .welcome-text {
      color: #ffb28c;
    }
    .welcome-cursor {
      background: #ffb28c;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* 需压过上面 #welcome-transition.active .welcome-plane 的优先级 */
    #welcome-transition.active .welcome-plane {
      animation: none;
    }
    .welcome-cursor {
      animation: none;
    }
  }
</style>

<script>
  (function () {
    var overlay = document.getElementById('welcome-transition');
    var textEl = overlay.querySelector('.welcome-content');
    var msg = 'Welcome to My Personal URL🥰';
    // 按码位切分，避免 emoji 被拆成乱码
    var chars = Array.from(msg);
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    // 过渡总时长：打字约 2s + 飞机爬升约 2.2s（比最初少 3s），4.2s 与飞行动画对齐，最高点处跳转
    var DURATION = 4200;

    function playTransition(url) {
      if (reduced.matches) {
        // 用户偏好减少动效时：静态显示文字，不做打字机
        textEl.textContent = msg;
      } else {
        var i = 0;
        var typing = setInterval(function () {
          textEl.textContent = chars.slice(0, ++i).join('');
          if (i >= chars.length) clearInterval(typing);
        }, 75);
      }
      overlay.classList.add('active');
      setTimeout(function () {
        // 标记来自过渡页跳转，落地页不再重复播进站动画
        try { sessionStorage.setItem('intro-transit', '1'); } catch (e) {}
        window.location.href = url;
      }, DURATION);
    }

    // 必须用捕获阶段：pjax 把监听器直接绑在链接元素上（目标阶段先于 document 冒泡），
    // 只有抢在它之前 preventDefault，pjax 检测到 defaultPrevented 才会放弃拦截
    document.addEventListener('click', function (event) {
      var link = event.target.closest('.menu-item-about a');
      if (!link) return;
      // 中键 / Ctrl / Cmd / Shift 点击（新标签页打开）不拦截
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      playTransition(link.href);
    }, true);
  })();
</script>

{# 进站欢迎页：两行打字 + 卫星飞过屏幕，随后揭示博客 #}
<div id="site-intro" aria-hidden="true">
  <p class="intro-line intro-line1"><span class="intro-text1"></span><span class="intro-cursor intro-cursor1"></span></p>
  <p class="intro-line intro-line2"><span class="intro-text2"></span><span class="intro-cursor intro-cursor2"></span></p>
  <div class="intro-satellite">🛰️</div>
</div>

<style>
  #site-intro {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: .8rem;
    background: linear-gradient(160deg, #fff6ee, #ffe3d1);
    transition: opacity .6s ease;
  }

  #site-intro.done {
    opacity: 0;
    pointer-events: none;
  }

  #site-intro .intro-line {
    margin: 0;
    padding: 0 1rem;
    min-height: 1.4em;
    font-weight: 700;
    text-align: center;
    color: #d94e10;
  }

  #site-intro .intro-line1 { font-size: clamp(1.4rem, 4.5vw, 2.6rem); }
  #site-intro .intro-line2 { font-size: clamp(1.1rem, 3.6vw, 2rem); }

  #site-intro .intro-cursor {
    display: inline-block;
    width: 3px;
    height: 1em;
    margin-left: 4px;
    vertical-align: -0.12em;
    background: #fc6423;
    animation: welcome-blink .8s step-end infinite;
  }

  #site-intro .intro-cursor2 { visibility: hidden; }
  #site-intro .intro-cursor2.on { visibility: visible; }
  #site-intro .intro-cursor.off { display: none; }

  #site-intro .intro-satellite {
    position: absolute;
    left: 50%;
    top: 68%;
    font-size: 2.8rem;
    opacity: 0;
    pointer-events: none;
  }

  #site-intro.flying .intro-satellite {
    animation: intro-sat-fly 2.5s ease-in-out forwards;
  }

  @keyframes intro-sat-fly {
    0%   { transform: translate(-62vw, 14px) rotate(10deg); opacity: 0; }
    12%  { opacity: 1; }
    50%  { transform: translate(0, -16px) rotate(0deg); }
    88%  { opacity: 1; }
    100% { transform: translate(62vw, 14px) rotate(-10deg); opacity: 0; }
  }

  @media (prefers-color-scheme: dark) {
    #site-intro {
      background: linear-gradient(160deg, #23262d, #38271c);
    }
    #site-intro .intro-line {
      color: #ffb28c;
    }
    #site-intro .intro-cursor {
      background: #ffb28c;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #site-intro .intro-cursor,
    #site-intro .intro-satellite {
      animation: none;
    }
  }
</style>

<script>
  (function () {
    var overlay = document.getElementById('site-intro');
    if (!overlay) return;

    // 从"关于"过渡页跳转过来时不再重复播进站动画
    try {
      if (sessionStorage.getItem('intro-transit')) {
        sessionStorage.removeItem('intro-transit');
        overlay.remove();
        return;
      }
    } catch (e) {}

    var text1 = overlay.querySelector('.intro-text1');
    var text2 = overlay.querySelector('.intro-text2');
    var cursor1 = overlay.querySelector('.intro-cursor1');
    var cursor2 = overlay.querySelector('.intro-cursor2');
    var msg1 = "Welcome to mingcheng98's Blog!";
    var msg2 = '🥭Never Stop Making Progress🥰';
    // 按码位切分，避免 emoji 被拆成乱码
    var chars1 = Array.from(msg1);
    var chars2 = Array.from(msg2);
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    var TYPE_INTERVAL = 75;
    var FLIGHT = 2500;

    var timers = [];
    function later(fn, ms) { timers.push(setTimeout(fn, ms)); }

    // 揭示博客：清掉未触发的定时器，淡出遮罩后移除（点击跳过也走这里）
    function reveal() {
      timers.forEach(clearTimeout);
      overlay.classList.add('done');
      setTimeout(function () { overlay.remove(); }, 700);
    }

    function typeLine(el, chars, done) {
      var i = 0;
      (function step() {
        el.textContent = chars.slice(0, ++i).join('');
        if (i < chars.length) later(step, TYPE_INTERVAL);
        else done();
      })();
    }

    overlay.addEventListener('click', reveal); // 点击任意处可跳过

    if (reduced.matches) {
      // 偏好减少动效：两行静态显示，稍作停留后直接进站
      text1.textContent = msg1;
      text2.textContent = msg2;
      cursor1.style.display = 'none';
      cursor2.style.display = 'none';
      later(reveal, 1500);
    } else {
      typeLine(text1, chars1, function () {
        cursor1.classList.add('off');
        cursor2.classList.add('on');
        typeLine(text2, chars2, function () {
          cursor2.classList.add('off');
          overlay.classList.add('flying'); // 卫星起飞
          later(reveal, FLIGHT);
        });
      });
    }

    later(reveal, 12000); // 兜底：异常情况下 12s 后必定放行
  })();
</script>

{# 首页分类筛选栏：「全部」+ 各分类一栏，点击筛选下方文章列表，并显示该分类的文章数与总字数。
   每篇文章的路径/分类/字数在构建时写进下方 JSON（全站值各页一致），pjax 切页时随页面换取新数据 #}
<div id="posts-filter" class="posts-filter" hidden>
  <div class="filter-tabs" role="tablist" aria-label="按分类筛选文章">
    <button type="button" class="filter-tab is-active" data-cat="">全部</button>
    {%- for cat in site.categories.toArray() %}
    <button type="button" class="filter-tab" data-cat="{{ cat.name }}">{{ cat.name }}</button>
    {%- endfor %}
  </div>
  <div class="filter-stats" aria-live="polite"></div>
</div>
<script id="posts-filter-data" type="application/json">[
  {%- for post in site.posts.toArray() %}
  {"path": "{{ url_for(post.path) }}", "cats": [{%- for c in post.categories.toArray() %}"{{ c.name }}"{% if not loop.last %}, {% endif %}{% endfor %}], "len": {{ post.length }}, "sticky": {{ post.sticky or 0 }} }{{ "," if not loop.last }}
  {%- endfor %}
]</script>

{# 侧边栏小卡片：文章页显示本文字数 + 实时阅读进度；首页显示全站总字数 #}
<div id="reading-widget" class="reading-widget" hidden>
  <div class="reading-row reading-row-count">
    <i class="far fa-file-lines" aria-hidden="true"></i>
    <span class="reading-label">字数统计</span>
    <b class="reading-wordcount">–</b>
  </div>
  <div class="reading-row reading-row-progress">
    <i class="fas fa-book-open" aria-hidden="true"></i>
    <span class="reading-label">阅读进度</span>
    <b class="reading-progress-text">0%</b>
  </div>
  <div class="reading-progress-track" role="progressbar" aria-label="阅读进度">
    <div class="reading-progress-fill"></div>
  </div>
</div>

<style>
  /* 首页分类筛选栏 */
  .posts-filter {
    margin: 0 0 1.6rem;
    padding: .8rem 1rem;
    background: var(--card-bg-color, rgba(0, 0, 0, .02));
    border: 1px solid rgba(0, 0, 0, .06);
    border-radius: 6px;
    text-align: center;
  }

  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .5rem;
  }

  .filter-tab {
    padding: .3rem 1.1rem;
    font-size: .92em;
    color: var(--text-color);
    background: transparent;
    border: 1px solid rgba(0, 0, 0, .14);
    border-radius: 999px;
    cursor: pointer;
    transition: color .2s, border-color .2s, background .2s;
  }

  .filter-tab:hover {
    color: #d94e10;
    border-color: #fc6423;
  }

  .filter-tab.is-active {
    color: #fff;
    background: linear-gradient(90deg, #fc8a5a, #fc6423);
    border-color: transparent;
  }

  .filter-stats {
    margin-top: .6rem;
    font-size: .85em;
    color: var(--text-color);
    opacity: .72;
    font-variant-numeric: tabular-nums;
  }

  /* 被筛选掉的文章整块隐藏 */
  .post-block[hidden] {
    display: none !important;
  }

  /* 侧边栏阅读小卡片 */
  .reading-widget {
    margin: 1rem 4px 4px;
    padding: .8rem .9rem;
    background: var(--content-bg-color);
    border: 1px solid rgba(0, 0, 0, .07);
    border-radius: 6px;
    font-size: .8rem;
  }

  .reading-row {
    display: flex;
    align-items: center;
    gap: .5em;
    margin-bottom: .5rem;
    color: var(--text-color);
  }

  .reading-row i {
    width: 1.15em;
    color: #fc6423;
    font-size: .95em;
    text-align: center;
  }

  .reading-label { flex: 1; }

  .reading-row b {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .reading-progress-track {
    height: 4px;
    border-radius: 2px;
    overflow: hidden;
    background: rgba(0, 0, 0, .08);
  }

  .reading-progress-fill {
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #fc8a5a, #fc6423);
    transition: width .15s linear;
  }

  @media (prefers-color-scheme: dark) {
    .posts-filter {
      border-color: rgba(255, 255, 255, .1);
    }

    .filter-tab {
      border-color: rgba(255, 255, 255, .18);
    }

    .filter-tab:hover {
      color: #ffb28c;
      border-color: #fc8a5a;
    }

    .reading-widget {
      border-color: rgba(255, 255, 255, .1);
    }

    .reading-progress-track {
      background: rgba(255, 255, 255, .12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress-fill { transition: none; }
  }

  /* hidden 属性优先级压过上面的 display: flex */
  #posts-filter[hidden],
  #reading-widget[hidden] {
    display: none !important;
  }
</style>

<script>
  (function () {
    var widget = document.getElementById('reading-widget');
    var filterBar = document.getElementById('posts-filter');
    if (!widget || !filterBar) return;

    // 侧边栏不在 pjax 更换范围内，小卡片搬进去一次即可长期复用
    var sidebarInner = document.querySelector('.sidebar-inner');
    if (sidebarInner) sidebarInner.appendChild(widget);

    var fill = widget.querySelector('.reading-progress-fill');
    var pctText = widget.querySelector('.reading-progress-text');
    var countEl = widget.querySelector('.reading-wordcount');
    var countLabel = widget.querySelector('.reading-row-count .reading-label');
    var progressRow = widget.querySelector('.reading-row-progress');
    var progressTrack = widget.querySelector('.reading-progress-track');
    var pending = false;

    // 首页判定：去掉站点路径前缀后只剩空串或 page/N（带分页时也认作首页）
    var ROOT = '{{ url_for("/") }}'.replace(/\/+$/, '');
    function isHomePage() {
      var rest = location.pathname.slice(ROOT.length).replace(/^\/+|\/+$/g, '');
      return rest === '' || /^page\/\d+$/.test(rest);
    }

    // 字数格式与 hexo-word-counter 一致（999 => 1k、9999 => 10k、>=1m => 1.2m）
    function fmtCount(n) {
      if (n >= 1000000) return (Math.round(n / 100000) / 10) + 'm';
      if (n > 9999) return Math.round(n / 1000) + 'k';
      if (n > 999) return (Math.round(n / 100) / 10) + 'k';
      return String(n);
    }

    // 全站总字数：累加筛选数据 JSON 里各文章的字数（与筛选栏同口径）
    function siteTotal() {
      var dataEl = document.getElementById('posts-filter-data');
      if (!dataEl) return null;
      try {
        var total = 0;
        JSON.parse(dataEl.textContent).forEach(function (p) { total += p.len || 0; });
        return fmtCount(total);
      } catch (err) {
        return null;
      }
    }

    // 字数优先读正文 meta 里 hexo-word-counter 的服务端统计值（pjax 切页后随 .main-inner 一起刷新），
    // 取不到时按「中文字数 + 英文单词数」现算，格式与插件一致（>999 => 1.1k）
    function readCount() {
      var icon = document.querySelector('.post-meta .fa-file-lines');
      var item = icon && icon.closest('.post-meta-item');
      if (item) {
        var spans = item.querySelectorAll('span');
        if (spans.length) return spans[spans.length - 1].textContent.trim();
      }
      var body = document.querySelector('.post-body');
      if (!body) return '–';
      var text = body.textContent;
      var n = (text.match(/[一-鿿]/g) || []).length + (text.match(/[A-Za-z0-9_]+/g) || []).length;
      if (n > 9999) return Math.round(n / 1000) + 'k';
      if (n > 999) return (Math.round(n / 100) / 10) + 'k';
      return String(n);
    }

    // 进度定义：正文顶部抵达视口顶部为 0%，正文底部抵达视口底部为 100%
    function updateProgress() {
      pending = false;
      if (widget.hidden || progressRow.hidden) return; // 首页只显示总字数，无进度
      var body = document.querySelector('.post-body');
      if (!body) return;
      var rect = body.getBoundingClientRect();
      var denom = rect.height - window.innerHeight;
      var pct = denom <= 0 ? 100 : Math.round(Math.min(100, Math.max(0, -rect.top / denom * 100)));
      fill.style.width = pct + '%';
      pctText.textContent = pct + '%';
    }

    function onScroll() {
      if (!pending) {
        pending = true;
        requestAnimationFrame(updateProgress);
      }
    }

    // 全局只绑一次：回调内部每次重新取 .post-body，pjax 换页后自动指向新正文
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);

    // 分类筛选：数据（路径/分类/字数）从 JSON 读取，每次现取现解析
    //（该 script 带 type="application/json"，pjax 切页时会随页面换新，需重新 getElementById）
    var activeCat = '';

    function setActive(cat) {
      activeCat = cat;
      filterBar.querySelectorAll('.filter-tab').forEach(function (tab) {
        tab.classList.toggle('is-active', tab.getAttribute('data-cat') === cat);
      });
      applyFilter();
    }

    function applyFilter() {
      var dataEl = document.getElementById('posts-filter-data');
      var statsEl = filterBar.querySelector('.filter-stats');
      if (!dataEl || !statsEl) return;
      var byPath = {};
      JSON.parse(dataEl.textContent).forEach(function (p) { byPath[p.path] = p; });

      var count = 0;
      var totalLen = 0;
      document.querySelectorAll('.main-inner .post-block').forEach(function (block) {
        var link = block.querySelector('.post-title-link');
        var entry = link && byPath[link.getAttribute('href')];
        // 置顶文章（sticky > 0）在所有分类下都保持显示
        var match = !activeCat || (entry && (entry.sticky || entry.cats.indexOf(activeCat) !== -1));
        block.hidden = !match;
        if (match) {
          count++;
          totalLen += entry ? entry.len : 0;
        }
      });
      statsEl.textContent = (activeCat || '全部') + '：' + count + ' 篇 · ' + fmtCount(totalLen) + ' 字';
    }

    // 事件绑在筛选栏节点上（只绑一次，节点随 refresh 重新插回文档后监听依然有效）
    filterBar.addEventListener('click', function (event) {
      var tab = event.target.closest('.filter-tab');
      if (tab) setActive(tab.getAttribute('data-cat'));
    });

    // 首次加载与每次 pjax 切页后都会触发，重算显隐与数值
    function refresh() {
      // 首页的摘要列表同样使用 .post-body，先排除，避免把首页误判成文章页
      var onHome = isHomePage();
      var hasPost = !!document.querySelector('.post-body');
      var isPost = hasPost && !onHome;
      if (isPost) {
        countLabel.textContent = '字数统计';
        countEl.textContent = readCount();
        progressRow.hidden = false;
        progressTrack.hidden = false;
        updateProgress();
        widget.hidden = false;
      } else if (onHome && hasPost) {
        // 首页：显示全站文章总字数；阅读进度对列表无意义，隐藏
        countLabel.textContent = '全站字数';
        var total = siteTotal();
        countEl.textContent = total === null ? '–' : total;
        progressRow.hidden = true;
        progressTrack.hidden = true;
        widget.hidden = false;
      } else {
        widget.hidden = true;
      }

      // 首页：插入分类筛选栏并重置到「全部」；其它页面隐藏
      // （置顶文章由 hexo-generator-index 按 sticky 值排到最前，筛选只做显隐、不会打乱顺序）
      var anchor = document.querySelector('.main-inner .post-block');
      if (isHomePage() && anchor) {
        if (filterBar.parentNode !== anchor.parentNode) anchor.parentNode.insertBefore(filterBar, anchor);
        filterBar.hidden = false;
        setActive('');
      } else {
        filterBar.hidden = true;
      }
    }

    document.addEventListener('page:loaded', refresh);
    refresh();
  })();
</script>
