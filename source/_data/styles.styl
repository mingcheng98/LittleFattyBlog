// 页脚的爱心 ❤ 换成橙子 🍊
// 原模板：<span class="with-love"><i class="fa fa-heart"></i></span>
.with-love {
  i {
    display: none;
  }
  &::after {
    content: "🍊";
  }
}

// 博客背景图：plane
// 直接铺在 body 上（html 无背景时会传导到画布最底层，不会被主题元素盖住）
// 透明度由叠加的遮罩控制：alpha 越大背景越淡/越浅，越小越深、越鲜艳
body {
  // 亮色模式：白色遮罩 0.5 ≈ 背景图 50% 可见
  background:
    linear-gradient(rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.5)) center / cover no-repeat fixed,
    url("../images/plane.jpg") center / cover no-repeat fixed;
}

// 暗色模式：改用深色遮罩，背景显得更深沉
@media (prefers-color-scheme: dark) {
  body {
    background:
      linear-gradient(rgba(35, 38, 45, 0.55), rgba(35, 38, 45, 0.55)) center / cover no-repeat fixed,
      url("../images/plane.jpg") center / cover no-repeat fixed;
  }
}

// 版块半透明化：让背景图透出来（文章多了也不会全部盖住）
// NexT Gemini 的文章卡片/侧栏/页头/分页都用 --content-bg-color，改这一个变量即可
// 透明度：alpha 越小越透（0.6 更透，0.85 更实）
:root {
  --content-bg-color: rgba(255, 255, 255, 0.75);
  --card-bg-color: rgba(255, 255, 255, 0.75);
}

// 暗色模式下的半透明版本（对应 NexT 的 #333 / #555）
@media (prefers-color-scheme: dark) {
  :root {
    --content-bg-color: rgba(51, 51, 51, 0.75);
    --card-bg-color: rgba(85, 85, 85, 0.75);
  }
}

// 标签/分类链接统一主题橙色（NexT 默认按文章数渐变用很浅的灰，半透明背景上几乎看不见）
// 覆盖：标签云、文章底部标签、分类/标签列表页、文章顶部"分类:"链接
// 以后新增标签/分类自动生效
.post-tags a,
.tag-cloud a,
.tag-list a,
.category-list a,
.post-meta-item a[rel="index"] {
  color: #fc6423;
  border-bottom-color: rgba(252, 100, 35, 0.4);
  &:hover {
    color: darken(#fc6423, 15%);
    border-bottom-color: darken(#fc6423, 15%);
  }
}

// 代码块行号与代码逐行对齐：
// hexo-util 的行号列（.gutter pre）字号是 1em，而代码侧内层 code.hljs 被
// NexT 的 `code { font-size: $table-font-size }`（.875em）缩小；行高是无单位
// 的 1.6、随各自字号缩放，于是代码每行比行号矮（1.6 × .125em ≈ 3px），
// 行数一多行号逐渐错位。把行号列字号对齐到代码侧，两侧每行即等高。
figure.highlight {
  .gutter pre {
    font-size: .875em;
  }
  // hljs 主题给 code.hljs 自带 1em 内边距，会让代码首行比行号低约一行，去掉
  .code pre code {
    padding: 0;
  }
}

// 代码块底部「收起」按钮（配合 body-end.njk 的反复折叠功能）：
// 与 NexT 原生 expand-btn 同位同风格，只在展开态出现
.code-collapse-btn {
  bottom: 0;
  left: 0;
  right: 0;
  position: absolute;
  text-align: center;
  cursor: pointer;
  color: var(--highlight-foreground);
  background-image: linear-gradient(to top, var(--highlight-background) 30%, rgba(0, 0, 0, 0) 100%);
  padding: 1.2em 0 .5em;
  font-size: $font-size-small;
  user-select: none;
  &:hover {
    color: #fc6423;
  }
}
